{
  "name": "signbox",
  "version": "0.1.0",
  "description": "Local controlled-signing daemon for software agents. Deterministic security boundary between a potentially compromised agent and a blockchain key.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "signbox": "./dist/cli/index.js",
    "signbox-mcp": "./dist/mcp/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.2.0",
    "@proton/js": "^30.1.0",
    "@proton/signing-request": "^5.1.0-rc-1",
    "@scure/base": "^2.2.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.2",
    "commander": "^15.0.0",
    "qrcode-terminal": "^0.12.0",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/sodium-native": "^2.3.9",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
