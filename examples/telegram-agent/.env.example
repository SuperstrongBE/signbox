# --- Telegram ---
# Create a bot with @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Optional: lock the bot to ONE group chat id (get it from @RawDataBot). Leave
# empty to answer in any chat it's added to.
TELEGRAM_GROUP_ID=

# --- OpenRouter (the LLM brain) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any TOOL-CALLING model on OpenRouter (browse https://openrouter.ai/models).
# Must support function/tool calling. Safe, cheap defaults:
#   openai/gpt-4o-mini   anthropic/claude-3.5-sonnet   google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- SignBox ---
# The onboarded agent account (its key signs; from = this account).
SIGNBOX_AGENT=funagent
# Path to the signbox CLI. Default "signbox" if it's on PATH (npm link / global).
SIGNBOX_BIN=signbox
# Optional: a specific SignBox config file.
# SIGNBOX_CONFIG=/home/you/.signbox/config.json
